generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayslipStatus {
  GENERATED
  PAID
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  employees   Employee[]

  @@map("departments")
}

model Employee {
  id           String         @id @default(cuid())
  empCode      String         @unique
  firstName    String
  lastName     String
  phone        String?
  designation  String
  joinDate     DateTime       @db.Date
  status       EmployeeStatus @default(ACTIVE)
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id])
  managerId    String?
  manager      Employee?      @relation("ManagerReports", fields: [managerId], references: [id])
  reports      Employee[]     @relation("ManagerReports")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user               User?
  salary             SalaryStructure?
  attendance         Attendance[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]  @relation("LeaveApplicant")
  reviewedLeaves     LeaveRequest[]  @relation("LeaveReviewer")
  payslips           Payslip[]
  payrollRunsCreated PayrollRun[]

  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  employeeId   String   @unique
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@map("users")
}

model SalaryStructure {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basic      Decimal  @db.Decimal(12, 2)
  hra        Decimal  @db.Decimal(12, 2)
  allowances Decimal  @db.Decimal(12, 2)
  pfPercent  Decimal  @default(12) @db.Decimal(5, 2)
  taxPercent Decimal  @default(5) @db.Decimal(5, 2)
  updatedAt  DateTime @updatedAt

  @@map("salary_structures")
}

model Attendance {
  id            String           @id @default(cuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime         @db.Date
  checkIn       DateTime
  checkOut      DateTime?
  workedMinutes Int              @default(0)
  status        AttendanceStatus @default(PRESENT)

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

model LeaveType {
  id          String         @id @default(cuid())
  name        String         @unique
  annualQuota Int
  isPaid      Boolean        @default(true)
  balances    LeaveBalance[]
  requests    LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  allocated   Int
  used        Int       @default(0)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id            String      @id @default(cuid())
  employeeId    String
  employee      Employee    @relation("LeaveApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  days          Int
  reason        String
  status        LeaveStatus @default(PENDING)
  reviewerId    String?
  reviewer      Employee?   @relation("LeaveReviewer", fields: [reviewerId], references: [id])
  reviewComment String?
  createdAt     DateTime    @default(now())
  reviewedAt    DateTime?

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model PayrollRun {
  id          String    @id @default(cuid())
  month       Int
  year        Int
  createdById String
  createdBy   Employee  @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  payslips    Payslip[]

  @@unique([month, year])
  @@map("payroll_runs")
}

model Payslip {
  id             String        @id @default(cuid())
  payrollRunId   String
  payrollRun     PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id])
  month          Int
  year           Int
  totalWeekdays  Decimal       @db.Decimal(5, 1)
  countedDays    Decimal       @db.Decimal(5, 1)
  presentDays    Decimal       @db.Decimal(5, 1)
  paidLeaveDays  Decimal       @db.Decimal(5, 1)
  lopDays        Decimal       @db.Decimal(5, 1)
  basic          Decimal       @db.Decimal(12, 2)
  hra            Decimal       @db.Decimal(12, 2)
  allowances     Decimal       @db.Decimal(12, 2)
  grossEarnings  Decimal       @db.Decimal(12, 2)
  pfDeduction    Decimal       @db.Decimal(12, 2)
  taxDeduction   Decimal       @db.Decimal(12, 2)
  lopDeduction   Decimal       @db.Decimal(12, 2)
  totalDeductions Decimal      @db.Decimal(12, 2)
  netPay         Decimal       @db.Decimal(12, 2)
  status         PayslipStatus @default(GENERATED)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}
